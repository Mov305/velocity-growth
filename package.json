    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6",
    "adm-zip": "^0.6.1",
    "csv-parse": "7",
    "dotenv": "17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postgres": "3",
    "prettier": "3",
    "supabase": "2",
    "tailwindcss": "^4",
