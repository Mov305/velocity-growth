    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "tsx scripts/gen-types.ts",
    "db:schema": "supabase db dump --local --schema public,app -f schema.sql",
    "env:local": "tsx scripts/local-env.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "poll:schedule": "tsx scripts/schedule-poll.ts",
    "seed:fetch": "tsx scripts/fetch-seed.ts",
    "import:seed": "tsx scripts/run-import.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
